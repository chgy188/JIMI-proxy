<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E4A7A" />
            <stroke android:width="3dp" android:color="#8FBFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2B4270" />
            <stroke android:width="1dp" android:color="#3E7BD8" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22314A" />
            <stroke android:width="1dp" android:color="#33445C" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
