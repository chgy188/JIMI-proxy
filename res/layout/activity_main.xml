<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1420"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="代理开关"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="写系统全局 HTTP 代理，填 Clash / V2Ray 的局域网地址与混合端口"
            android:textColor="#8A97AE"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="代理地址"
            android:textColor="#C8D2E4"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_host"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_bg"
            android:hint="192.168.10.173"
            android:inputType="text"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#4E5A6E"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="端口"
            android:textColor="#C8D2E4"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_port"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_bg"
            android:hint="7890"
            android:inputType="number"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#4E5A6E"
            android:textSize="18sp" />

        <com.robin.proxyswitch.ToggleSwitchView
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="26dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="right"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test"
                android:layout_width="300dp"
                android:layout_height="62dp"
                android:background="@drawable/btn_bg"
                android:text="测试代理是否可用"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:text="正在读取状态…"
            android:textColor="#9FB0C9"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="说明：本应用写的是系统全局代理（对所有应用生效，重启后仍保留）。\n本机是 test-keys 构建，APK 已用平台密钥签名，安装后即自动获得写入权限；\n若装到别的机器提示无权限，可用 adb 设置，或把 APK 放进 /system/priv-app。"
            android:textColor="#6C7A91"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
